APP_NAME="JRV CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# High Availability Database Configuration
# Supports single node or Master/Replica read-write splitting
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jrv_crm
DB_USERNAME=root
DB_PASSWORD=

# Optional: Comma-separated list of read replicas (e.g., 10.0.0.5,10.0.0.6)
# If empty or not set, read queries automatically fall back to DB_HOST.
# DB_READ_HOST=

# Enable persistent PDO connections for reduced connection handshake overhead in high-throughput clusters
DB_PERSISTENT=false

# ------------------------------------------------------------------------------
# Load Balancer & Reverse Proxy Trust
# Use '*' to trust all reverse proxies (NGINX, Cloudflare, AWS ALB) or specify IPs
# ------------------------------------------------------------------------------
TRUSTED_PROXIES=*

# ------------------------------------------------------------------------------
# Shared Session & Multi-Tenant Wildcard Domain
# Set to 'redis' or 'database' for load-balanced multi-node clusters
# Set SESSION_DOMAIN=.yourdomain.com to share session cookies across tenant subdomains
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------------------------------------
# Cache & Distributed Locks
# Set to 'redis' or 'database' for multi-node deployments
# ------------------------------------------------------------------------------
CACHE_STORE=file
CACHE_PREFIX=

# ------------------------------------------------------------------------------
# Asynchronous Background Queue Worker
# Set to 'redis' or 'database' to offload heavy jobs (PDF export, email, AI)
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# Redis In-Memory Store
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Mail Configuration
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
